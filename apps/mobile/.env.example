# このファイルを .env という名前でコピーして値を入れてください（Web 版と同じ値でOK）
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# シフト表の読み取り機能で使う、Web 版サーバーの URL（docs/shift-reader-setup.md 参照）
# 開発中は空のままで OK（スマホ実機では、パソコンの IP アドレスに自動で置き換えます）。
# 本番ではデプロイした Web 版の URL を指定します（docs/mobile-device-testing.md 参照）
EXPO_PUBLIC_API_BASE_URL=
