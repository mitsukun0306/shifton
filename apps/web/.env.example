# このファイルを .env.local という名前でコピーして値を入れてください
# 値の場所: Supabase ダッシュボード > Project Settings > API Keys（docs/supabase-setup.md 参照）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# シフト表の読み取り機能（AI 画像認識）で使う Anthropic の API キー（docs/shift-reader-setup.md 参照）
# サーバー側だけで使う秘密の値です。NEXT_PUBLIC_ を付けないでください
ANTHROPIC_API_KEY=
