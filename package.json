{
  "name": "shifton",
  "private": true,
  "description": "しふとん！ アルバイトのシフト管理アプリ",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @shifton/web dev",
    "dev:mobile": "pnpm --filter @shifton/mobile start",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "turbo": "2.11.13",
    "typescript": "~6.0.3"
  }
}
